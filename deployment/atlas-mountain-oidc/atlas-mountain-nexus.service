[Unit]
Description=Atlas Mountain Nexus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atlasmountain
Group=atlasmountain
UMask=0022
WorkingDirectory=/opt/atlas-mountain/current
EnvironmentFile=/etc/atlas-mountain/atlas.env
# Atlas-native accounts are the normal production human-auth authority. Keep
# this fixed receiver-side copy aligned with the immutable Atlas release unit:
# nginx's /__atlas_mountain_auth subrequest depends on the loopback auth sidecar
# being available on 127.0.0.1:43105. Break-glass public mode must be an explicit
# runtime override, never the receiver bootstrap default.
Environment=NEXUS_NATIVE_AUTH_ENABLED=true
Environment=ATLAS_QUANTUM_PYTHON=/var/lib/atlas-mountain/qiskit-venv/bin/python
ExecStartPre=+/usr/bin/env bash /opt/atlas-mountain/current/deploy/hetzner/repair-workspace.sh
ExecStart=/usr/bin/env bash /opt/atlas-mountain/current/deploy/hetzner/start-nexus.sh
ExecStartPost=/usr/bin/env bash /opt/atlas-mountain/current/deploy/hetzner/verify-nexus-runtime.sh
Restart=on-failure
RestartSec=3
TimeoutStartSec=90
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/atlas-mountain
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
