[Unit]
Description=Atlas Mountain Nexus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atlasmountain
Group=atlasmountain
UMask=0022
WorkingDirectory=/opt/atlas-mountain/current
EnvironmentFile=/etc/atlas-mountain/atlas.env
# Native Atlas accounts are the production human-auth authority. The runtime
# still supports an explicit NEXUS_AUTH_MODE=public break-glass override when
# deliberately configured, but deployments must not enable it by default.
Environment=NEXUS_NATIVE_AUTH_ENABLED=true
Environment=ATLAS_QUANTUM_PYTHON=/var/lib/atlas-mountain/qiskit-venv/bin/python
Environment=ATLAS_COMPUTE_PYTHON=/var/lib/atlas-mountain/compute-venv/bin/python
ExecStartPre=+/usr/bin/env bash /opt/atlas-mountain/current/deploy/hetzner/repair-workspace.sh
# Atlas Compute Fabric is a specialist deterministic runtime. Installation is
# non-fatal and time-bounded so package/network trouble cannot hold general
# Nexus offline; stdlib fallbacks remain usable and compute.catalogue reports
# exactly which specialist libraries are live.
ExecStartPre=-+/usr/bin/timeout 120s /usr/bin/env bash /opt/atlas-mountain/current/deploy/hetzner/install-compute-runtime.sh
# Music DSP is an important specialist capability but must not be allowed to
# take the general assistant offline if apt/network repair is temporarily
# unavailable. Music Dungeon will expose the missing capability and invoke the
# recovery fabric rather than pretending analysis/mastering succeeded.
ExecStartPre=-+/usr/bin/env bash /opt/atlas-mountain/current/deploy/hetzner/install-music-runtime.sh
# Browser QA is important but must never make Nexus unavailable. The leading '-'
# makes installation failure non-fatal; the Website Studio/immune layer then
# treats missing Playwright as an explicit quality-gate incident.
ExecStartPre=-+/usr/bin/env bash /opt/atlas-mountain/current/deploy/hetzner/install-playwright-runtime.sh
ExecStart=/usr/bin/env bash /opt/atlas-mountain/current/deploy/hetzner/start-nexus.sh
ExecStartPost=/usr/bin/env bash /opt/atlas-mountain/current/deploy/hetzner/verify-nexus-runtime.sh
Restart=on-failure
RestartSec=3
TimeoutStartSec=180
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/atlas-mountain
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
