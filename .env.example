# .env.example
# Required for most AI writing/design routes (or run Ollama locally)
GEMINI_API_KEY=

# Optional server bind
PORT=3000
# Optional production data dir (jobs + backups). Defaults to ./data
# CASPA_DATA_DIR=/root/Caspa/data

# Optional: xAI Grok API Key for unrestricted creative writing
VITE_GROK_API_KEY=
# Optional: Anthropic Claude API Key
VITE_ANTHROPIC_API_KEY=
# Optional: OpenAI API Key
VITE_OPENAI_API_KEY=
# Optional: Venice.ai API Key for production art
VITE_VENICE_API_KEY=
# Optional: Firebase Tenant ID (for multi-tenancy)
VITE_FIREBASE_TENANT_ID=
# Optional: Ollama base URL (default http://127.0.0.1:11434/api)
# On the same machine as Ollama, leave unset. Remote example:
# OLLAMA_URL=http://127.0.0.1:11434/api
OLLAMA_URL=

# Optional: Host Unified Router (OpenAI-compatible /api/chat/completions)
# Preferred AI path when set — tried before cloud provider keys.
# Same host:     http://127.0.0.1:9999
# Docker bridge: http://172.18.0.1:9999
# External: nginx vhost in /etc/nginx/conf.d/auth-gateway.conf
# UNIFIED_ROUTER_URL=http://127.0.0.1:9999
# UNIFIED_ROUTER_API_KEY=
# UNIFIED_ROUTER_MODEL=llama3.2
UNIFIED_ROUTER_URL=
