# .env.example
# Required for most AI writing/design routes (or run Ollama locally)
GEMINI_API_KEY=

# Required production security and canonical server-first storage.
# Generate a high-entropy secret and keep it identical to the trusted nginx value.
CASPA_PROXY_SHARED_SECRET=
# PostgreSQL connection used for users, projects, revisions and hybrid-core records.
CASPA_DATABASE_URL=postgresql://caspa:change-me@127.0.0.1:5432/caspa
# Required; comma or pipe separated Authentik groups allowed to read detailed diagnostics.
CASPA_OPS_GROUPS=authentik Admins,caspa-ops

# Optional server bind
PORT=3000
# Optional production data dir (jobs + backups). Defaults to ./data
# CASPA_DATA_DIR=/root/Caspa/data

# Optional durable vision spend ceilings (defaults shown).
# CASPA_VISION_DAILY_TOKEN_CEILING=80000
# CASPA_VISION_DAILY_COST_CENTS=800
# CASPA_VISION_GLOBAL_DAILY_TOKEN_CEILING=400000
# CASPA_VISION_GLOBAL_DAILY_COST_CENTS=4000

# Optional: xAI Grok API Key for unrestricted creative writing
VITE_GROK_API_KEY=
# Optional: Anthropic Claude API Key
VITE_ANTHROPIC_API_KEY=
# Optional: OpenAI API Key
VITE_OPENAI_API_KEY=
# Optional: Venice.ai API Key for production art
VITE_VENICE_API_KEY=
# Optional: Firebase Tenant ID (for multi-tenancy)
VITE_FIREBASE_TENANT_ID=
# Optional: Ollama base URL (default http://127.0.0.1:11434/api)
# On the same machine as Ollama, leave unset. Remote example:
# OLLAMA_URL=http://127.0.0.1:11434/api
OLLAMA_URL=

# Optional: Host Unified Router (OpenAI-compatible /api/chat/completions)
# Preferred AI path when set — tried before cloud provider keys.
# Same host:     http://127.0.0.1:9999
# Docker bridge: http://172.18.0.1:9999
# External: nginx vhost in /etc/nginx/conf.d/auth-gateway.conf
# UNIFIED_ROUTER_URL=http://127.0.0.1:9999
# UNIFIED_ROUTER_API_KEY=
# UNIFIED_ROUTER_MODEL=llama3.2
UNIFIED_ROUTER_URL=

# Atlas shared knowledge/corpus engine
# Local semantic embeddings via Ollama. Pull with: ollama pull embeddinggemma
KNOWLEDGE_EMBED_MODEL=embeddinggemma
# Set to off for lexical-only emergency mode.
KNOWLEDGE_EMBEDDINGS=on
# Maximum single cloud source temporarily downloaded for extraction (bytes).
KNOWLEDGE_MAX_FILE_BYTES=367001600
# Maximum provider inventory records per scan.
KNOWLEDGE_INVENTORY_LIMIT=25000
# Audio/video transcription model. whisper-1 is used for segment timecodes.
KNOWLEDGE_TRANSCRIBE_MODEL=whisper-1

# Unattended cloud knowledge ingestion
# Generate a high-entropy server-only value (production deploy creates one if absent).
CLOUD_TOKEN_ENCRYPTION_KEY=
ATLAS_PUBLIC_URL=https://caspa.ocrowley.com
KNOWLEDGE_SYNC_INTERVAL_MS=300000
KNOWLEDGE_SYNC_BATCH=8
# Dropbox platform OAuth app (offline PKCE refresh tokens).
DROPBOX_APP_KEY=
# Google OAuth Web Application credentials for Drive offline access.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
